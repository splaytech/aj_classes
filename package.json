{
  "name": "aj-classes",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "preview": "pnpm --filter web preview",
    "lint": "pnpm --filter web lint",
    "typecheck": "pnpm --filter web typecheck",
    "test": "pnpm --filter web test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "start:railway": "pnpm --filter web start:railway",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:status": "supabase status",
    "db:types": "supabase gen types typescript --local > apps/web/src/services/database.types.ts && prettier --write apps/web/src/services/database.types.ts"
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  }
}
