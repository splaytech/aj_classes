# Settings for every build (Vercel Production and Preview, and `pnpm build`). Committed on purpose:
# both values are PUBLIC by design (they end up in the site's JavaScript anyway; the database's
# access rules protect the data). Never put a secret here (sb_secret_…, service role, Turnstile
# secret, SMTP or Zoho credentials): those live only in Supabase (go-live.md §3).
# A value set in Vercel's environment variables overrides the one here.
#
# One hosted Supabase project serves staging and prod (owner decision, 22 Oct 2026).
VITE_SUPABASE_URL=https://unzjnxctkyahtmrkinyr.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_RcrO-f-2jyjJyfTWNWy0IQ_1NwGbnhb

# Cloudflare Turnstile SITE key (public: it's in the page's HTML). Its secret lives only in
# Supabase. Setting it switches the portal on; done 22 Oct 2026 after the database, sign-in
# settings and email (Resend, verified) were ready (go-live.md).
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAFgYQo42mBIws5tY

# Website enquiries are also saved and sent to Zoho CRM as leads (leads-and-crm.md); the leads
# function and its Zoho secrets are deployed and tested.
VITE_LEAD_CAPTURE=on
