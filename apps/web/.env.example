# Copy to .env.local for local development. Read ONLY in src/constants/app.constants.ts (PRP F8.4).

# Public site URL (canonical, sitemap, OG tags). Defaults to the production domain.
VITE_SITE_URL=https://ajclasses.com.au

# Web3Forms public access key (safe to expose; it only allows sending to the verified inbox).
VITE_FORM_ACCESS_KEY=

# Staff portal (Release 2a). Without all three, the portal is switched off and "Staff sign in" is hidden.
# Local: run `pnpm db:status` for the publishable key; Turnstile test key 1x00000000000000000000AA always passes.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_TURNSTILE_SITE_KEY=
