# Copy to .env.local for local development. Read ONLY in src/constants/app.constants.ts (PRP F8.4).

# Public site URL (canonical, sitemap, OG tags). Defaults to the production domain.
VITE_SITE_URL=https://ajclasses.com.au

# Web3Forms public access key (safe to expose; it only allows sending to the verified inbox).
VITE_FORM_ACCESS_KEY=

# Kit (formerly ConvertKit) form ID for the footer newsletter sign-up. Public, safe to expose.
# Find it in Kit: Grow → Landing Pages & Forms → your form → the number in the URL.
# Leave empty to hide the sign-up form.
VITE_KIT_FORM_ID=

# Which copy of the site this is: production, staging or development (environments.md).
# Required for every build (the build fails without it). The local dev server defaults to
# development. On Vercel: production for Production, staging for Preview.
VITE_APP_ENV=development
