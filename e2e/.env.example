# Settings for the E2E suite. Don't copy this file by hand: generate e2e/.env (gitignored) with
#   node e2e/scripts/local-env.mjs > e2e/.env
# which keeps every line below and adds the local stack's keys from `supabase status`.
# Every value here is a local-only value for the Supabase CLI stack; none is a real secret, and
# none may ever point at the hosted project (src/config.ts refuses non-local hosts).

# Web dev server (`pnpm --filter web dev`). Must be port 5173: supabase/config.toml hardcodes 5173
# in both ALLOWED_ORIGINS (the `leads` function's CORS allow-list, used by the Register Interest
# spec) and the Auth site_url/redirect allow-list (used by the Invite onboarding spec). The dev
# server binds IPv6 loopback, so use "localhost", not "127.0.0.1".
WEB_BASE_URL=http://localhost:5173

# Settings for the dev server that global setup starts if 5173 isn't up (it inherits this env).
# CI sets the same values as job env; a value already in the environment (CI's job env) wins
# over e2e/.env, as dotenv doesn't override (unconfirmed on a GitHub run). Public, local-only values: the local API, Cloudflare's
# always-pass Turnstile test key, a placeholder Web3Forms key (Web3Forms is always mocked), and
# lead capture on so enquiries reach the local `leads` function.
VITE_SUPABASE_URL=http://127.0.0.1:55321
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
VITE_FORM_ACCESS_KEY=local-placeholder
VITE_LEAD_CAPTURE=on

# Local Supabase CLI stack (`pnpm db:start`).
PG_HOST=127.0.0.1
PG_PORT=55322
PG_DATABASE=postgres
PG_USER=postgres
PG_PASSWORD=postgres

SUPABASE_REST_URL=http://127.0.0.1:55321
# Filled in by scripts/local-env.mjs from `supabase status`. Never commit a key here.
SUPABASE_ANON_KEY=<from supabase status>
SUPABASE_SERVICE_ROLE_KEY=<from supabase status>
VITE_SUPABASE_PUBLISHABLE_KEY=<from supabase status>

MAILPIT_URL=http://127.0.0.1:55324

# Local seed account, not real: the test admin created by supabase/seed.sql, which already
# publishes this password and two-step seed.
ADMIN_EMAIL=admin@local.test
ADMIN_PASSWORD=local-password-123
ADMIN_TOTP_SEED=LOCALDEVADMINKEYLOCALDEVADMINKEY
ADMIN_LANDING_PATH=/portal/admin

# The aj_classes checkout global setup starts the dev server from. Relative paths are resolved
# from this e2e/ folder; the default is the repo root.
AJ_CLASSES_DIR=..

# Polling / timeout budgets (ms)
POLL_TIMEOUT_MS=8000
POLL_INTERVAL_MS=400
SETUP_TIMEOUT_MS=60000
